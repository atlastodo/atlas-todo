# Copy to .env next to compose.yaml and adjust. Never commit .env.
#
# Only what compose itself reads is listed here. The server container receives every variable in
# this file: every server setting (rate limits, passkeys, S3, admins, …) is documented in core's
# .env.example and docs/self-hosting.md (https://github.com/atlastodo/atlas).

# Required. Postgres password (it goes into a URL: openssl rand -hex 24) and the token-signing
# secret (openssl rand -hex 32).
POSTGRES_PASSWORD=
JWT_SECRET=

# POSTGRES_USER=atlas
# POSTGRES_DB=atlas
# Host address and port the server is published on; 8080 listens on every interface.
# PORT_BIND=127.0.0.1:8080
# The image; pin a version in production.
# ATLAS_TODO_IMAGE=ghcr.io/atlastodo/atlas-todo:latest
# Postgres data volume name (with `-p <name>`: <name>_atlas_db).
# ATLAS_DB_VOLUME=docker_atlas_db
