# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# The jest cache CI keeps inside the checkout; Prettier skips it via this file, ESLint via its own
# ignores.
/.jest-cache/

# Node / Bun / frontend
node_modules/
dist/
dist-desktop/
dist-web/
atlas-desktop-*.tar.gz
atlas-todo-web-*.tar.gz
# nix build outputs
result
result-*
.vite/
*.tsbuildinfo
bun.lockb.tmp

# Env / secrets
.env
.env.*
!.env.example
*.local

# Android (signing keystores never belong in the repo)
.android/
*.jks
*.keystore
local.properties
*.apk
*.aab
apps/mobile/android/
apps/mobile/ios/
# The local Expo modules' Gradle output from a native build (Prettier skips what is ignored here).
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/.gradle/
# A local native Android project, never tracked.
apps/android/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.claude/
.opencode/

# Local agent tooling state
/.agents/

# Generated by scripts/third-party-licenses.mjs (CI and release builds)
THIRD_PARTY_NOTICES.txt
